@page "/"

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Smart-X System Gateway</h1>
        <p class="lead text-muted">Select an architectural pillar to manage your IoT network.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="list-group shadow-sm">
                <a href="/dashboard" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-4 border-primary border-start border-4">
                    <div>
                        <h5 class="mb-1 fw-bold text-dark">Sensor Data Ingestion and Telemetry</h5>
                        <small class="text-muted">Monitor real-time sensor streams, attach logs, and spot anomalies.</small>
                    </div>
                    <span class="badge bg-primary rounded-pill">Active</span>
                </a>
                <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-4 disabled" tabindex="-1">
                    <div>
                        <h5 class="mb-1 fw-bold text-muted">Real-Time Command Stream and History</h5>
                        <small class="text-muted">Send commands and view historical logs.</small>
                    </div>
                    <span class="badge bg-secondary rounded-pill">Disabled</span>
                </a>
                <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-4 disabled" tabindex="-1">
                    <div>
                        <h5 class="mb-1 fw-bold text-muted">Network Topology and Mesh Routing</h5>
                        <small class="text-muted">Visualize network mesh and routing paths.</small>
                    </div>
                    <span class="badge bg-secondary rounded-pill">Disabled</span>
                </a>
            </div>
        </div>
    </div>
</div>
