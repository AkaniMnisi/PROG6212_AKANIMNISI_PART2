@page "/"

<PageTitle>SmartX System Gateway</PageTitle>

<div class="hero-section">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold text-white mb-2">Smart-X System Gateway</h1>
            <p class="lead text-white-50">Select an architectural pillar to get started</p>
        </div>

        <div class="row justify-content-center g-4">
            <div class="col-md-4">
                <a href="/dashboard" class="text-decoration-none">
                    <div class="pillar-card active-card">
                        <div class="icon-circle bg-primary">
                            <span class="icon">📡</span>
                        </div>
                        <h5 class="mt-3">Sensor Data Ingestion</h5>
                        <p class="text-muted small">Real-time telemetry pipeline</p>
                        <span class="badge bg-success">Active</span>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <div class="pillar-card disabled-card">
                    <div class="icon-circle bg-secondary">
                        <span class="icon">🎮</span>
                    </div>
                    <h5 class="mt-3">Command Stream</h5>
                    <p class="text-muted small">Real-time control & history</p>
                    <span class="badge bg-secondary">Disabled</span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pillar-card disabled-card">
                    <div class="icon-circle bg-secondary">
                        <span class="icon">🌐</span>
                    </div>
                    <h5 class="mt-3">Network Topology</h5>
                    <p class="text-muted small">Mesh routing overview</p>
                    <span class="badge bg-secondary">Disabled</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        min-height: 90vh;
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        display: flex;
        align-items: center;
    }

    .pillar-card {
        background: white;
        border-radius: 16px;
        padding: 2rem 1.5rem;
        text-align: center;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
    }

    .active-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 32px rgba(0,0,0,0.25);
    }

    .disabled-card {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .icon-circle {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

    .icon {
        font-size: 1.8rem;
    }

    .pillar-card h5 {
        color: #1e3c72;
        font-weight: 600;
    }
</style>